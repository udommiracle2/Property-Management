PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/housing_system
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d
NODE_ENV=development

# Optional — welcome emails on registration are skipped (with a console
# warning) if these aren't set. Works with any SMTP provider: Gmail (use
# an App Password, not your normal password), Outlook/Office365,
# SendGrid/Mailgun/SES SMTP relay, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="EstateHub <no-reply@example.com>"
